{
  "name": "halveth-realms",
  "productName": "HALVETH Realms",
  "version": "0.2.0",
  "description": "Scarlet Garden: an original desktop fantasy sandbox with local dialogue, LOVE and living communities.",
  "type": "module",
  "main": "desktop/main.cjs",
  "private": true,
  "license": "MIT",
  "author": { "name": "Juri-Halveth", "url": "https://github.com/Juri-Halveth" },
  "homepage": "https://github.com/Juri-Halveth/halveth-realms",
  "repository": { "type": "git", "url": "https://github.com/Juri-Halveth/halveth-realms.git" },
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server.mjs",
    "launch": "node scripts/launch.mjs",
    "test": "node --test tests/*.test.mjs desktop/tests/*.test.cjs",
    "release": "node scripts/release.mjs",
    "evolve": "node scripts/evolve-content.mjs",
    "desktop": "electron .",
    "desktop:runtime": "node node_modules/electron/install.js",
    "icons": "node scripts/build-icons.mjs",
    "desktop:dir": "electron-builder --win --x64 --dir --publish never",
    "desktop:build": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": { "electron": "44.4.3", "electron-builder": "26.15.3", "@resvg/resvg-js": "2.6.2" }
}
